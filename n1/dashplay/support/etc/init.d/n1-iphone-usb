#!/bin/sh /etc/rc.common
START=19

start() {
    [ "$(uci -q get dashplay.main.enabled)" = 1 ] || return 0
    mkdir -p /run/dashplay || return 1
    touch /run/dashplay/usb-tether || return 1
    modprobe ipheth || return 1
    # An earlier router-mode switch can leave an already plugged phone unbound.
    for dev in /sys/bus/usb/devices/*:*; do
        [ ! -e "$dev/driver" ] && [ -r "$dev/bInterfaceSubClass" ] || continue
        [ "$(cat "${dev%:*}/idVendor" 2>/dev/null)" = 05ac ] || continue
        [ "$(cat "$dev/bInterfaceClass")/$(cat "$dev/bInterfaceSubClass")" = ff/fd ] || continue
        printf '%s' "${dev##*/}" > /sys/bus/usb/drivers/ipheth/bind || continue
    done
    for dev in /sys/bus/usb/drivers/ipheth/*:*/net/*; do
        [ -e "$dev" ] || continue
        /usr/libexec/n1-iphone-usb-name "${dev##*/}"
    done
}

stop() {
    [ -f /run/dashplay/usb-tether ] || return 0
    rm -f /run/dashplay/usb-tether /run/dashplay/n1-last-wired
    # Release only the tether interface we named. CarPlay's NCM functions stay separate.
    dev=$(readlink -f /sys/class/net/iphonewan0/device) || return 0
    [ "$(readlink -f "$dev/driver")" = /sys/bus/usb/drivers/ipheth ] || return 0
    printf '%s' "${dev##*/}" > /sys/bus/usb/drivers/ipheth/unbind || [ ! -e "$dev/driver" ]
}
