#!/bin/sh
# Match the phone's Ethernet function, never CarPlay's NCM interfaces or a modem.
iface=${1:-}
[ -f /run/dashplay/usb-tether ] && [ -n "$iface" ] || exit 0
driver=$(readlink -f "/sys/class/net/$iface/device/driver") || exit 0
[ "${driver##*/}" = ipheth ] || exit 0
if [ "$iface" != iphonewan0 ]; then
    [ ! -e /sys/class/net/iphonewan0 ] || exit 0
    ip link set dev "$iface" down && ip link set dev "$iface" name iphonewan0 || exit 1
fi
# Transport selection belongs to n1-connection-policy; keep a healthy wireless session.
